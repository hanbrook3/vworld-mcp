# HandFun 환경 변수 (전부 선택 사항이다. 아무것도 없어도 앱은 동작한다)

# 서버 포트
PORT=8090

# 데이터 저장 위치 (기본값: handfun/data)
# HANDFUN_DATA_DIR=/var/lib/handfun

# --- 매칭 민감도 ---------------------------------------------------------
# 값을 낮추면 인식은 잘 되지만 엉뚱한 곡을 잡을 수 있다.
# HANDFUN_MIN_VOTES=8
# HANDFUN_MIN_RATIO=1.5
# HANDFUN_MIN_SIGNIFICANCE=4

# --- 외부 가사 (키 불필요) -----------------------------------------------
# 끄려면 off 로 설정
# HANDFUN_LRCLIB=off

# --- 외부 음악 인식 (선택) -----------------------------------------------
# 내 카탈로그에 없는 곡까지 인식하고 싶을 때만 설정한다.
# ACRCloud 는 재생 위치(play_offset_ms)를 주기 때문에 싱크에 바로 쓸 수 있다.
# ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

# AudD 는 곡 정보 위주라 재생 위치를 못 받을 수 있다.
# AUDD_API_TOKEN=
